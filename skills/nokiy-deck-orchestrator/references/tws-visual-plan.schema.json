{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nokiyliao.net/schemas/tws-visual-plan.schema.json",
  "title": "TWS per-slide visual plan",
  "type": "object",
  "required": ["schema_version", "catalog_sha256", "slides"],
  "properties": {
    "schema_version": { "const": "tws_deck_visual_plan_v1" },
    "catalog_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slide", "role", "visual_type", "visual_purpose"],
        "properties": {
          "slide": { "type": "integer", "minimum": 1 },
          "role": { "type": "string", "minLength": 1 },
          "visual_type": {
            "enum": [
              "official_asset",
              "concept_asset",
              "generated_concept",
              "editable_diagram",
              "data_visual",
              "typography_only"
            ]
          },
          "visual_purpose": { "type": "string", "minLength": 1 },
          "asset_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "generation_prompt": { "type": "string", "minLength": 1 },
          "diagram_spec": { "type": "object", "minProperties": 1 },
          "source_ref": { "type": "string", "minLength": 1 },
          "exception_reason": { "type": "string", "minLength": 1 },
          "hero": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
