{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tws-presentation-input-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "job_id", "lead_id", "company_name", "location",
    "permit", "building_use", "floor_area_m2", "source_snapshot",
    "deck_mode", "asset_catalog", "output_filename", "created_at"
  ],
  "properties": {
    "schema_version": {"const": "tws-presentation-input-v1"},
    "job_id": {"type": "string", "minLength": 1},
    "lead_id": {"type": "string", "minLength": 1},
    "company_name": {"type": "string", "minLength": 1},
    "location": {"type": "string"},
    "permit": {"type": "string"},
    "building_use": {"type": "string"},
    "floor_area_m2": {"type": ["number", "null"]},
    "source_snapshot": {"type": "string", "minLength": 1},
    "deck_mode": {"enum": ["editable", "revision"]},
    "custom_cover": {"type": "boolean", "default": true},
    "asset_catalog": {"type": "string", "minLength": 1},
    "output_filename": {"type": "string", "pattern": "\\.pptx$"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
