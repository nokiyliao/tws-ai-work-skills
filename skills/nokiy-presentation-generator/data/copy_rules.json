{
  "_comment": "Human-readable deck copy rules consumed by qa_check.py. Keep this short and strict; these are presentation copy smells, not a dictionary.",
  "customer_facing": {
    "max_title_units": 24,
    "max_claim_units": 44,
    "max_slide_body_units": 120,
    "banned_fluff_terms": [
      "不只",
      "不僅",
      "真正的",
      "賦能",
      "助力",
      "形而上",
      "全面升級",
      "無縫接軌",
      "卓越",
      "開創",
      "革新",
      "最佳化解決方案",
      "一站式服務"
    ],
    "discouraged_fluff_terms": [
      "打造",
      "全方位",
      "智慧化",
      "數位轉型",
      "藍圖",
      "主軸",
      "策略方向",
      "方案架構",
      "導入路徑",
      "整體方案",
      "解決方案",
      "可視化",
      "高效",
      "落地",
      "本案建議",
      "本次規劃",
      "我們建議",
      "本頁"
    ],
    "weak_copy_patterns": [
      "(?:^|[。！？；\\n])\\s*先(?!進先出)",
      "先.{0,40}(?:，|、|；|\\s)?再",
      "不是.{0,40}(?:，|、|；|\\s)?而是",
      "不在.{0,40}(?:，|、|；|\\s)?而在",
      "並非.{0,40}(?:，|、|；|\\s)?而是",
      "不只是?.{0,40}(?:，|、|；|\\s)?而是",
      "不僅.{0,40}(?:而且|還|也)",
      "真正的.{0,30}(?:是|價值|重點|關鍵|改變)",
      "透過.{0,24}(提升|優化|打造|實現)",
      "有助於",
      "可有效",
      "進一步",
      "從而",
      "致力於",
      "以.{0,16}(為核心|為主軸|為藍圖|為基礎)",
      "建立.{0,12}(完整|全方位|一站式)",
      "(?:本案|本次|我們)(?:建議|規劃|將)",
      "(?:透過|藉由).{0,24}(提升|優化|強化|實現)",
      "(?:可|能夠|有助於).{0,16}(提升|優化|強化|降低)"
    ],
    "weak_title_patterns": [
      "先(?!進先出)",
      "整體.*方案",
      ".*導入.*策略",
      ".*導入.*方向",
      ".*改善.*主軸",
      ".*解決方案.*藍圖",
      ".*專案.*架構",
      "以.*為主軸"
    ]
  }
}
